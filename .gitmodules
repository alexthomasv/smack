# Submodule pins are enforced by the gitlink object that git records when
# the superproject commits a submodule. `tools/check_submodule_pins.sh`
# diffs `git submodule status` against `tools/submodule-pins.txt` in CI;
# update both files together when intentionally moving a submodule.
#
# Do NOT run `git submodule update --remote` without also updating
# tools/submodule-pins.txt — `--remote` silently follows upstream HEAD.
[submodule "external/deltarel"]
  path = external/deltarel
  url = git@github.com:alexthomasv/deltarel.git
  # pinned: 20e3b69a906c24a9ace772e42087e1a5cc66720c
